# Build context excludes — keep the image lean and secrets out of it.
node_modules
.next
.git
.gitignore
.env
.env.*
!.env.example
storage
ailegal_hussein

# Tests never run in the image
**/*.test.ts
**/*.test.tsx
**/*.integration.test.ts
src/__integration__
vitest.config.mts
vitest.integration.config.mts
vitest.setup.mts
vitest.integration.setup.mts

# Local / editor / CI noise
.claude
.vscode
*.log
npm-debug.log*
coverage
.DS_Store

# Generated locally; the image builds its own copies
ocr-models
test-results
playwright-report
backups
storage-staging

# Test harnesses (HTTP-level, browser E2E, AI staging) never run in the image
src/__http__
src/__staging__
e2e
vitest.http.config.mts
vitest.staging.config.mts
playwright.config.ts
