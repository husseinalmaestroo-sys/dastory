# Database — MySQL connection string the app uses.
#   - Local dev:        mysql://root@localhost:3307/dostoori   (XAMPP is 3307)
#   - Docker (compose): leave DATABASE_URL unset — docker-compose.yml builds it
#     from the MYSQL_* values below and points it at the `db` service.
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/DATABASE_NAME"

# --- docker-compose only ---------------------------------------------------
# Credentials for the bundled MySQL 8 container (docker-compose.yml). The app
# container's DATABASE_URL is assembled from these; you do not set it directly
# in the Docker deployment. deploy/setup-vps.sh generates random values here.
MYSQL_DATABASE="dostoori"
MYSQL_USER="dostoori"
MYSQL_PASSWORD="change-me-generate-a-random-value"
MYSQL_ROOT_PASSWORD="change-me-generate-a-different-random-value"
# -------------------------------------------------------------------------

# JWT signing secret — REQUIRED, at least 32 random characters, and must not
# be this placeholder or any other known/example value. The app refuses to
# start otherwise, in every environment (not just production). Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars"

# Encryption key for 2FA (TOTP) secrets at rest — REQUIRED, same rules as
# JWT_SECRET above (>=32 chars, not a placeholder). Use a different value
# than JWT_SECRET. Generate with the same command shown above.
TWO_FACTOR_ENCRYPTION_KEY="change-this-to-a-different-random-secret-32-chars-min"

# Public origin of the app — REQUIRED (the app refuses to start without it).
# Every emailed link (password reset, email verification) is built from this,
# never from the request's Host header. Bare origin, no path. https:// in
# production (deploy/deploy.sh enforces it).
APP_URL="https://app.example.com"

# Platform admins — REQUIRED, no default. Comma-separated allow-list. Being
# listed here is necessary but NOT sufficient: an account is a platform
# admin only after an operator grants it on the server
#   node scripts/platform-admin.mjs grant <email>
#   (Docker: docker compose exec app node scripts/platform-admin.mjs grant <email>)
# and only while it is an office manager with a verified email and 2FA on.
# Signing up with a listed address grants nothing.
PLATFORM_ADMIN_EMAILS="you@your-domain.example"

# Set to 1 only when the app sits behind a reverse proxy you control that
# sets X-Real-IP (the nginx config from deploy/setup-nginx.sh does). Rate
# limits and audit logs then use the real client address. Unset/0 = forwarded
# headers are ignored (safe default for direct exposure / local dev).
# docker-compose.yml sets it to 1.
# TRUST_PROXY="1"

# Email (SMTP) — verification / password-reset links and dashboard email.
# Leave commented out until you have real credentials: with SMTP unset the
# app says "email not configured" instead of attempting sends with
# placeholder credentials (new accounts then can't verify their email, which
# gates AI features, team invites and client-portal accounts).
# Gmail example: use an App Password (not your real password)
# Hostinger example: use your hosting email SMTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="مكتب المحاماة <your@gmail.com>"

# Backups (deploy/backup.sh, deploy/setup-backups.sh, BACKUP.md).
# deploy/deploy.sh REQUIRES the passphrase: it takes an encrypted backup
# before every migration and refuses to deploy without one. Keep a copy of
# the passphrase OFF this host — it is the only key to the backups.
# BACKUP_ENCRYPTION_PASSPHRASE="..."            # openssl rand -base64 48
# BACKUP_RCLONE_REMOTE="remote-name:bucket/dostoori"   # off-host copies (rclone)
# BACKUP_REQUIRE_OFFHOST="1"                    # fail the backup if the remote copy fails
# BACKUP_RETENTION_DAYS="14"                    # local copies
# BACKUP_REMOTE_RETENTION_DAYS="90"             # remote copies
# BACKUP_ALERT_WEBHOOK="https://..."            # POSTed to when a backup/drill fails

# Development only: log password-reset / verification links to the server
# console when SMTP is not configured. Ignored unless NODE_ENV=development;
# links are bearer tokens, so never enable this anywhere logs are shared.
# DEV_LOG_EMAIL_LINKS="true"

# Error tracking (Sentry) — OPTIONAL. Unset = the SDK is fully inert (no
# events, no network). Set it to send unhandled server/API errors to your
# Sentry project. Server-side only (no browser SDK). PII — emails, tokens,
# request bodies — is stripped before send (src/lib/sentry-scrub.ts).
# SENTRY_DSN="https://xxxx@oyyyy.ingest.sentry.io/zzzz"
# SENTRY_ENVIRONMENT="production"   # optional; defaults to NODE_ENV

# AI features (legal search, general assistant, AI case analysis, contract
# drafting, contract review) — OPTIONAL. Without this, the app boots
# normally and every non-AI feature works; the AI endpoints return a clear
# 503 "not configured" instead of a fake response. Backed by ailegal_hussein
# (./ailegal_hussein — its own git repo, checked out inside this one), a
# standalone service this app calls over HTTP after its own auth/tenant/
# rate-limit checks — see src/lib/ai/legal-rag-client.ts and ARCHITECTURE.md.
# There is no separate Anthropic-direct path any more — document OCR is the
# one AI-adjacent feature that needs neither key (real Tesseract.js, local,
# no external API). AI_LEGAL_SERVICE_KEY must equal INTERNAL_SERVICE_KEY in
# ailegal_hussein's own .env — generate one shared value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   - Local dev:        AI_LEGAL_SERVICE_URL="http://localhost:4000" — start the engine
#     first with ailegal_hussein\run-dev.bat (it serves on port 4000; this app
#     uses 3000). If it is not running, every AI answer is "تعذّر الاتصال…" and
#     the server log says why (ECONNREFUSED, ENOTFOUND…).
#   - Docker (compose): AI_LEGAL_SERVICE_URL is set to http://legal_app:3000 in
#     docker-compose.yml — both containers share the `dostoori_net` network.
# AI_LEGAL_SERVICE_URL="http://localhost:4000"
# AI_LEGAL_SERVICE_KEY="..."
# Overrides the per-call deadline for upstream AI calls (headers AND body).
# Defaults are per feature in src/lib/ai/legal-rag-client.ts (60s for chat/
# search, 120s for documents). Rarely needed.
# AI_LEGAL_SERVICE_TIMEOUT_MS="30000"

# OCR language models are bundled (npm postinstall copies them into
# ./ocr-models); nothing is downloaded at runtime. Override the directory only
# if you ship them elsewhere.
# OCR_MODELS_DIR="/app/ocr-models"

# Seed scripts refuse to run unless explicitly allowed, and never with
# NODE_ENV=production: ALLOW_DEV_SEED=true (prisma/seed.ts),
# ALLOW_PILOT_SEED=true (scripts/seed-pilot-audit.mjs).

# Platform billing (Stripe) — architecture only right now, not connected.
# See ARCHITECTURE.md "Known gaps" and src/lib/billing.ts before setting
# these; they are not read anywhere yet.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
