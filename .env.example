# ---- Database ----
# Local docker-compose: postgresql://legal:legal@localhost:5432/ai_legal
# Neon / Supabase: paste the connection string. Any remote host gets TLS
# forced on automatically (src/lib/pg-ssl.ts), so a missing ?sslmode= is fine.
DATABASE_URL=postgresql://legal:legal@localhost:5432/ai_legal

# Phase 2.4 — which database this is (src/lib/db-target.ts). Every writing
# command prints its target and refuses an undeclared remote database;
# production also needs --confirm-production. A loopback host is "local".
# DATABASE_ENVIRONMENT=branch                 # branch | staging | production
# PRODUCTION_DATABASE_HOST=ep-xxx.region.aws.neon.tech   # always production, even if declared otherwise
# Where port 5432 is filtered: Postgres over Neon's WebSocket proxy on 443
# (src/lib/db-pool.ts), through HTTPS_PROXY when one is set.
# DATABASE_TRANSPORT=tcp                      # tcp | neon-websocket

# ============================================================
#  Chat and embeddings are CHOSEN SEPARATELY — on purpose.
#
#  Anthropic publishes no embeddings endpoint: Claude is chat-only. So "use
#  Claude" always means Claude for answers plus a second vendor for vectors.
#  One combined provider setting could not express that.
# ============================================================

# ---- Chat ----  openai | anthropic
CHAT_PROVIDER=openai

OPENAI_API_KEY=sk-replace-me
OPENAI_CHAT_MODEL=gpt-4o-mini

# Only read when CHAT_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-replace-me
# ANTHROPIC_MODEL=claude-opus-4-8

# ---- Embeddings ----  openai | voyage
# "anthropic" is not a valid value here — see the note above.
EMBEDDING_PROVIDER=openai

# openai: text-embedding-3-small (1536) | text-embedding-3-large (3072)
# voyage: voyage-3-large (1024 default) — needs VOYAGE_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# VOYAGE_API_KEY=pa-replace-me

# !! EMBEDDING_DIM is baked into the `embedding` column at migration time.
#    Changing the embedding model or provider means a different vector width,
#    so it is NOT a config flip: re-run `npm run db:migrate` against an empty
#    database and re-index the whole corpus. Mixing widths fails at INSERT.

# ---- Admin ----
# Single shared password for the admin dashboard (MVP-grade, no user accounts yet).
ADMIN_PASSWORD=change-me-now

# ---- Lawyer gate ----
# Signs the lawyer identity cookie (src/lib/lawyer-auth.ts). Never commit a
# real one; rotating it logs every lawyer out (they just re-enter their name).
LAWYER_SESSION_SECRET=generate-a-long-random-string

# ---- Privacy ----
# Salt used to hash visitor IPs. Rotate = analytics identities reset. Never commit a real one.
IP_HASH_SALT=generate-a-long-random-string

# ---- Trusted server-to-server caller: Dostoori (src/lib/service-auth.ts) ----
# HMAC signing key shared with Dostoori (its AI_LEGAL_SERVICE_KEY). It is
# never sent on the wire: Dostoori signs a short-lived (≤120 s), single-use
# assertion per request, bound to the office, the authenticated user, the
# method, the path and a SHA-256 of the exact body (header X-Dostoori-Assertion).
# The old X-Internal-Service-Key + X-Dostoori-Office-Id headers are REJECTED.
# Service calls store no content here (only content-free ai_requests rows),
# and are limited per office (cost) and per office user (rate).
# INTERNAL_SERVICE_KEY=generate-a-long-random-string
# USD/day one Dostoori office may spend through this service (safety net
# under Dostoori's own plan quota).
# COST_CAP_PER_OFFICE_USD=5
# Trust X-Real-IP from the local reverse proxy for per-connection limits
# (standalone users). Leave unset when not behind our own nginx.
# TRUST_PROXY=1

# ---- Cost guardrails (src/lib/costcap.ts, src/lib/ai/request.ts) ----
# Daily USD circuit breakers backed by Postgres (cost_ledger). Standalone
# users are keyed on a salted IP hash (X-Real-IP only when TRUST_PROXY=1);
# Dostoori calls on their office. Every model call is priced at its own model
# (src/lib/ai/usage-meter.ts).
#
# COST_CAP_PER_USER_USD: one IP's spend/day across chat + case-upload analysis
# + drafting before every further request from it is refused until the next
# UTC day. Default 2 — see env.ts for how that number was picked.
COST_CAP_PER_USER_USD=2
# COST_CAP_SITE_USD: the whole site's spend/day, across every user, before
# EVERY paid request anywhere is refused — the backstop for distributed abuse
# or a genuine traffic spike. Default 20 — a starting judgment call with no
# production traffic to size it against yet; revisit after real launch
# volume exists. Set to 0 as an emergency kill switch.
COST_CAP_SITE_USD=20

# ---- Storage ----
STORAGE_DIR=./storage

# ---- Retrieval tuning ----
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.30

# ---- General-knowledge fallback ----
# true  : when the knowledge base has no source, answer from the model's
#         general knowledge — orientation only. src/lib/ai/guard.ts strips
#         every article/decision/law number from that answer before it is sent,
#         and the UI fences it in an amber "إجابة عامة" block. Recorded with
#         grounded=false, so the dashboard's grounded ratio still counts it as
#         unsupported.
# false : refuse instead ("لم أجد سنداً قانونياً كافياً…"), the original
#         closed-domain behaviour.
#
# The guard is code, not a prompt instruction — a prompt asks, and the model
# writes "المادة 780" anyway. Only grounded answers may carry citations,
# because only there is a real source behind the number.
# Phase 2: default false, and never used for Dostoori calls. The no-evidence
# answer says plainly that the database holds no sufficient source.
ALLOW_GENERAL_FALLBACK=false
# Model-memory supplements next to a grounded answer — standalone only, off by default.
# GPT_HYBRID_FALLBACK=false
# GAP_FILL_ENABLED=false

# ---- Query understanding & expansion ----
# QUERY_LLM_FALLBACK: when the rule tier cannot confidently classify a question,
# fall back to one small model call. Clear questions (an article number, a
# drafting imperative, "ما الفرق بين…") never reach it, and the call is issued
# in parallel with retrieval — so this costs no wall-clock latency.
QUERY_LLM_FALLBACK=true
# LEGAL_QUERY_EXPANSION: merge statutory synonyms from src/lib/search/legal-ontology.ts
# into the search text before retrieval, so "أخذ مبلغاً وقال إنه قرض" reaches the
# article that says "مال مسلَّم على وجه الأمانة". The ontology is free and runs on
# every query; the LLM source is limited to fact_pattern questions.
LEGAL_QUERY_EXPANSION=true

# ---- Reranking (OFF by default) ----
# A cross-encoder rescores the top candidates by reading the question and each
# passage TOGETHER — the judgement RRF structurally cannot make, since it only
# fuses two rankings.
#
# Left at "none" on purpose: a reranker is a quality claim, and a quality claim
# without a measurement is a guess. Run `npx tsx scripts/benchmark-rerank.ts`
# and compare MRR against the baseline before switching this on.
#   none    : plain RRF (current, measured baseline)
#   cohere  : needs COHERE_API_KEY. Default model rerank-multilingual-v3.0
#   voyage  : needs VOYAGE_API_KEY. Default model rerank-2
RERANK_PROVIDER=none
# RERANK_MODEL=rerank-multilingual-v3.0
# COHERE_API_KEY=
# How many fused candidates the reranker sees. Only applies when reranking is
# on; with it off the arms keep their original depth, so enabling this cannot
# silently change un-reranked results.
RERANK_CANDIDATES=50

# Error tracking (Sentry) — OPTIONAL. Unset = the SDK is fully inert.
# Set it to send unhandled errors (via logError / onRequestError) to Sentry.
# Server-side only. PII — emails, tokens, request bodies — is stripped before
# send (src/lib/sentry-scrub.ts).
# SENTRY_DSN=https://xxxx@oyyyy.ingest.sentry.io/zzzz
# SENTRY_ENVIRONMENT=production

# ---- Phase 2: deadlines, retrieval versioning, retention ----
# LLM_TIMEOUT_MS=45000             # one non-streamed model call
# LLM_STREAM_IDLE_TIMEOUT_MS=20000 # silence tolerated inside a stream
# EMBED_TIMEOUT_MS=20000           # one embeddings call (retried once)
# AI_REQUEST_DEADLINE_MS=          # override every feature's overall deadline (tests)
# LEGACY_EMBEDDING_MODEL=text-embedding-3-small   # model of vectors stored before embedding_model was recorded
# LAW_SCOPED_EXACT=true            # scope "المادة N من قانون X" to law X (false = old behaviour, for measurement)
# MERGE_ARTICLE_PARTS=true         # re-join split articles before the model reads them
# CONTENT_RETENTION_DAYS=90        # standalone chat_history / uploaded_cases / stored PDFs (scripts/purge-content.ts)

# ---- Offline test providers (CI / evaluation only) ----
# CHAT_PROVIDER=test EMBEDDING_PROVIDER=test are deterministic, network-free
# stand-ins (src/lib/ai/test-provider.ts). Refused in production unless
# ALLOW_TEST_PROVIDERS=true. ALLOW_SYNTHETIC_CORPUS=true lets retrieval serve
# the synthetic fixtures (eval/fixtures) — never set it in production.
