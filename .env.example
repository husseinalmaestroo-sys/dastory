# Database — Hostinger MySQL
# Replace with your Hostinger credentials from hPanel > Databases
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/DATABASE_NAME"

# JWT signing secret — REQUIRED, at least 32 random characters, and must not
# be this placeholder or any other known/example value. The app refuses to
# start otherwise, in every environment (not just production). Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars"

# Encryption key for 2FA (TOTP) secrets at rest — REQUIRED, same rules as
# JWT_SECRET above (>=32 chars, not a placeholder). Use a different value
# than JWT_SECRET. Generate with the same command shown above.
TWO_FACTOR_ENCRYPTION_KEY="change-this-to-a-different-random-secret-32-chars-min"

# Platform admins — comma-separated emails allowed to access /admin and global trial requests
PLATFORM_ADMIN_EMAILS="admin@dostoori.jo"

# Email (SMTP) — for sending emails from the dashboard
# Gmail example: use an App Password (not your real password)
# Hostinger example: use your hosting email SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="مكتب المحاماة <your@gmail.com>"

# Backups (scripts/backup-db.sh, scripts/backup-files.sh) — not needed to
# run the app itself, only to run the backup scripts. See BACKUP.md.
# BACKUP_ENCRYPTION_PASSPHRASE="..."
# BACKUP_RCLONE_REMOTE="remote-name:bucket/path"

# AI features (legal assistant, contract review) — OPTIONAL. Without this,
# the app boots normally and every non-AI feature works; the AI endpoints
# return a clear 503 "not configured" instead of a fake response. Get a key
# at https://console.anthropic.com/settings/keys.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-5"   # optional, defaults to claude-sonnet-5

# Legal search (RAG over real Jordanian legislation/case law) — OPTIONAL,
# and separate from the ANTHROPIC_API_KEY above. Backed by ailegal_hussein
# (../ailegal_hussein), a standalone service this app calls over HTTP after
# its own auth/tenant/rate-limit checks — see src/lib/ai/legal-rag-client.ts.
# Without these two, /dashboard/search/legal returns a clear 503 instead of
# a fake result. AI_LEGAL_SERVICE_KEY must equal INTERNAL_SERVICE_KEY in
# ailegal_hussein's own .env — generate one shared value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AI_LEGAL_SERVICE_URL="http://localhost:3001"
# AI_LEGAL_SERVICE_KEY="..."

# Platform billing (Stripe) — architecture only right now, not connected.
# See ARCHITECTURE.md "Known gaps" and src/lib/billing.ts before setting
# these; they are not read anywhere yet.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
