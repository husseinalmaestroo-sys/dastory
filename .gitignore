# Dependencies
node_modules

# ailegal_hussein is its own independent git repository (separate app,
# separate deploy) living inside this folder — never part of Dostoori's own
# history. Dostoori calls it over HTTP; see src/lib/ai/legal-rag-client.ts.
/ailegal_hussein

# Build output / caches
.next
*.tsbuildinfo
/dist
/build
/coverage

# Certificates & private keys — never belong in version control
*.pem
*.key
*.crt

# Env files — never commit real secrets
.env
.env.*
!.env.example

# Logs
*.log

# Uploaded documents (user data — never belongs in version control)
/storage
/storage-staging

# Local encrypted DB/file backups produced by scripts/backup-*.sh
/backups

# Generated Prisma client (if ever configured with a custom output path)
/src/generated/prisma

# Misc local state
.data
*.tmp
*.sqlite
*.sqlite3
*.db
.DS_Store
Thumbs.db

# Claude Code local session state — permission history can contain
# incidental local test data; this file is machine/session-specific and not
# meant to be shared.
.claude/settings.local.json

# Tesseract models copied out of node_modules by scripts/prepare-ocr-models.mjs
/ocr-models

# Playwright output
/test-results
/playwright-report
