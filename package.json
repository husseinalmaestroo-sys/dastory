{
  "name": "ai-legal-assistant",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --tsconfig scripts/tsconfig.verify.json scripts/seed.ts",
    "ingest": "tsx --tsconfig scripts/tsconfig.verify.json scripts/bulk-ingest.ts",
    "fetch": "tsx --tsconfig scripts/tsconfig.verify.json scripts/fetch-sources.ts",
    "verify": "tsx --tsconfig scripts/tsconfig.verify.json scripts/verify-pipeline.ts",
    "benchmark": "tsx --tsconfig scripts/tsconfig.verify.json scripts/benchmark.ts",
    "mine-failed-queries": "tsx --tsconfig scripts/tsconfig.verify.json scripts/mine-failed-queries.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --tsconfig scripts/tsconfig.verify.json --test tests/unit/*.test.ts",
    "test:integration": "tsx --tsconfig scripts/tsconfig.verify.json --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:http": "tsx --tsconfig scripts/tsconfig.verify.json --test --test-concurrency=1 tests/http/*.test.ts",
    "eval:offline": "tsx --tsconfig scripts/tsconfig.verify.json scripts/eval.ts --mode offline",
    "eval:live": "tsx --tsconfig scripts/tsconfig.verify.json scripts/eval.ts --mode live",
    "purge": "tsx --tsconfig scripts/tsconfig.verify.json scripts/purge-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "@napi-rs/canvas": "^0.1.65",
    "@sentry/nextjs": "^10.73.0",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "dotenv": "^16.6.1",
    "nanoid": "^5.0.9",
    "next": "15.5.25",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "puppeteer": "^25.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
