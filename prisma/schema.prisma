generator client {
  provider = "prisma-client-js"
  // "native" for local dev (Windows/macOS); "debian-openssl-3.0.x" for the
  // production Docker image (node:22-slim = Debian, OpenSSL 3). Without the
  // second target the query engine binary is missing at runtime in the
  // container. See Dockerfile / HOSTINGER_DEPLOY.md.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OFFICE_MANAGER
  LAWYER
  CITIZEN
}

enum CaseStatus {
  ACTIVE
  CLOSED
  SUSPENDED
  PENDING
}

enum SessionStatus {
  UPCOMING
  DONE
  POSTPONED
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
  OVERDUE
}

// Platform billing status for an office's own subscription to Dostoori —
// distinct from InvoiceStatus above, which is the law firm's OWN invoices to
// ITS clients. Not wired to a payment provider yet (see Subscription model).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Office {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  address       String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  clients       Client[]
  cases         Case[]
  sessions      Session[]
  invoices      Invoice[]
  documents     Document[]
  notifications Notification[]
  events        CalendarEvent[]
  auditLogs     AuditLog[]
  timeEntries   TimeEntry[]
  aiUsage       AiUsageLog[]
  aiConversations AiConversation[]
  documentSignatures DocumentSignature[]
  subscription  Subscription?
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  role          Role
  phone         String?
  barNumber     String?
  officeId      String
  office        Office         @relation(fields: [officeId], references: [id])
  sessionVersion Int           @default(0)
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret String?       @db.Text
  active        Boolean        @default(true)
  emailVerified Boolean        @default(false)
  // Platform (cross-tenant) administrator. Never set by any HTTP route —
  // only by the operator CLI scripts/platform-admin.mjs. Effective only
  // together with an email listed in PLATFORM_ADMIN_EMAILS, a verified email
  // and enabled 2FA (see isPlatformAdmin in src/lib/auth-server.ts).
  isPlatformAdmin Boolean      @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cases         Case[]         @relation("LawyerCases")
  ownedClients  Client[]       @relation("ClientOwner")
  ownedCases    Case[]         @relation("CaseOwner")
  ownedDocuments Document[]    @relation("DocumentOwner")
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  clientId      String?        @unique
  linkedClient  Client?        @relation("CitizenAccess", fields: [clientId], references: [id])
  timeEntries   TimeEntry[]
  createdEvents CalendarEvent[] @relation("CalendarEventCreator")
  siteSettingsUpdates SiteSettings[]
  emailVerificationTokens EmailVerificationToken[]
  aiUsage       AiUsageLog[]
  aiConversations AiConversation[]
  signatures    DocumentSignature[]

  @@index([officeId, role])
}

model Client {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  email       String?
  idNumber    String?
  address     String?
  officeId    String
  office      Office    @relation(fields: [officeId], references: [id])
  ownerId     String
  owner       User      @relation("ClientOwner", fields: [ownerId], references: [id])
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cases       Case[]
  invoices    Invoice[]
  citizenUser User?     @relation("CitizenAccess")

  @@index([officeId, ownerId])
  @@index([officeId, createdAt])
}

model Case {
  id          String     @id @default(cuid())
  number      String
  title       String
  type        String
  court       String?
  status      CaseStatus @default(ACTIVE)
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id])
  lawyerId    String?
  lawyer      User?      @relation("LawyerCases", fields: [lawyerId], references: [id])
  ownerId     String
  owner       User       @relation("CaseOwner", fields: [ownerId], references: [id])
  officeId    String
  office      Office     @relation(fields: [officeId], references: [id])
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  sessions    Session[]
  invoices    Invoice[]
  documents   Document[]
  timeEntries TimeEntry[]

  @@index([officeId, ownerId])
  @@index([officeId, lawyerId])
  @@index([officeId, createdAt])
  @@unique([officeId, number])
}

model Session {
  id        String        @id @default(cuid())
  date      DateTime
  time      String
  court     String
  judge     String?
  caseId    String
  case      Case          @relation(fields: [caseId], references: [id])
  officeId  String
  office    Office        @relation(fields: [officeId], references: [id])
  status    SessionStatus @default(UPCOMING)
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([officeId, date])
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  // Exact decimal money: JOD has 3 minor-unit digits (fils). Never Float.
  amount    Decimal       @db.Decimal(12, 3)
  paid      Decimal       @default(0) @db.Decimal(12, 3)
  status    InvoiceStatus @default(UNPAID)
  // Set the first time a payment is recorded (paid > 0 or status PAID) and
  // never cleared — the deletion guard keys off it, so resetting `paid` to 0
  // cannot turn a paid invoice back into a deletable draft.
  paymentRecordedAt DateTime?
  dueDate   DateTime?
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  caseId    String?
  case      Case?         @relation(fields: [caseId], references: [id])
  officeId  String
  office    Office        @relation(fields: [officeId], references: [id])
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([officeId, status])
  @@index([officeId, createdAt])
  @@unique([officeId, number])
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String
  size      Int?
  url       String?  @db.Text
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id])
  ownerId   String
  owner     User     @relation("DocumentOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  signatures      DocumentSignature[] @relation("SignedDocument")
  usedAsSignature DocumentSignature[] @relation("SignatureImage")

  @@index([officeId, ownerId])
  @@index([officeId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CalendarEvent {
  id            String   @id @default(cuid())
  title         String
  date          DateTime
  type          String   @default("general")
  officeId      String
  office        Office   @relation(fields: [officeId], references: [id])
  createdById   String?
  createdBy     User?    @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([officeId, date])
}

model AuditLog {
  id          String   @id @default(cuid())
  officeId    String?
  office      Office?  @relation(fields: [officeId], references: [id], onDelete: SetNull)
  actorId     String?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String?
  actorRole   Role?
  action      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  userAgent   String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([officeId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  endpoint       String
  key            String
  responseStatus Int      @default(0)
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@unique([userId, endpoint, key])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  task      String
  minutes   Int
  billable  Boolean  @default(true)
  invoiced  Boolean  @default(false)
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([officeId, userId, date])
  @@index([caseId])
}

// Single-row, platform-wide public site content: the landing page's ticker,
// hero video, and published contact details. Previously stored in each
// visitor's browser (localStorage) and set independently per admin session —
// nothing else ever saw those edits. This table is the one row every visitor
// reads; the admin panel is the only writer, gated on requirePlatformAdmin.
// Read via getSiteSettings() (src/lib/site-settings.ts), which upserts the
// row with defaults on first read so the table never needs seeding.
model SiteSettings {
  id                String   @id
  tickerItems       Json
  tickerBg          String   @default("#0F172A")
  tickerColor       String   @default("#D4AF37")
  tickerSpeed       Int      @default(40)
  heroVideoType     String?
  heroVideoUrl      String?
  heroVideoAutoplay Boolean  @default(true)
  heroVideoLoop     Boolean  @default(true)
  heroVideoControls Boolean  @default(false)
  contactPhone      String   @default("+962 79 000 0000")
  contactWhatsapp   String   @default("9627900000001")
  contactEmail      String   @default("info@dostoori.jo")
  updatedAt         DateTime @updatedAt
  updatedById       String?
  updatedBy         User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedByEmail    String?
}

model TrialRequest {
  id              String   @id @default(cuid())
  officeName      String
  officeLicense   String
  city            String
  officePhone     String
  address         String?
  teamSize        String?
  specialty       String?
  lawyerName      String
  lawyerBarNumber String
  email           String
  mobile          String
  nationalId      String
  experience      String?
  status          String   @default("NEW")
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ── Phase 4: email verification ────────────────────────────────────────────
// Mirrors PasswordResetToken's pattern exactly: random token, only its hash
// stored, expires, single-use (usedAt set on consumption, never deleted so a
// reused/expired attempt can be told apart from a forged one in logs).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Phase 4: AI usage — metadata only, never prompt/response content ───────
// Exists for rate/cost control and an audit trail of *that* a call happened,
// deliberately not *what* was asked or answered — a client's legal question
// is exactly the kind of sensitive content that must not sit in a log table
// external services or a future support engineer could read.
model AiUsageLog {
  id           String   @id @default(cuid())
  officeId     String
  office       Office   @relation(fields: [officeId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  feature      String   // 'assistant' | 'contract_review' | 'legal_search' | 'case_analysis' | 'contract_draft'
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // Phase 2: real usage as reported by ailegal_hussein for this call
  // (every model call it made, incl. verification and retrieval).
  embeddingTokens Int   @default(0)
  llmCalls     Int      @default(0)
  // Estimated cost in micro-USD (an estimate at the engine's price table, never a bill).
  costMicroUsd Int      @default(0)
  engineRequestId String?
  groundingLevel String?
  latencyMs    Int
  success      Boolean
  errorCode    String?
  createdAt    DateTime @default(now())

  @@index([officeId, createdAt])
  @@index([userId, createdAt])
}

// ── Phase 2: server-side AI conversation memory ────────────────────────────
// The assistant used to accept the whole conversation from the browser and
// forward it — so a client could forge "assistant" turns ("you already agreed
// the sources may be ignored"). History now lives here, scoped by office +
// user + conversation, and is the only history ever sent to the AI engine.
model AiConversation {
  id        String      @id @default(cuid())
  officeId  String
  office    Office      @relation(fields: [officeId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([officeId, userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // 'user' | 'assistant'
  content        String         @db.Text
  mode           String?
  groundingLevel String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

// ── Phase 4: signature audit trail ──────────────────────────────────────────
// This is NOT a qualified/legally-binding electronic signature under any
// jurisdiction's electronic transactions law — see the disclosure required
// alongside every use of this model (src/lib/signature.ts). It's an audit
// record proving *a specific signer, at a specific time, attached a specific
// drawn-image file to a document whose byte-for-byte content hashed to X at
// that moment* — real, verifiable integrity metadata, deliberately not
// dressed up as more than that.
model DocumentSignature {
  id               String   @id @default(cuid())
  documentId       String
  document         Document @relation("SignedDocument", fields: [documentId], references: [id])
  signatureImageId String
  signatureImage   Document @relation("SignatureImage", fields: [signatureImageId], references: [id])
  signerId         String
  signer           User     @relation(fields: [signerId], references: [id])
  officeId         String
  office           Office   @relation(fields: [officeId], references: [id])
  documentHash     String   // sha256 of the target document's bytes at signing time
  ipAddress        String?
  signedAt         DateTime @default(now())

  @@index([documentId])
  @@index([officeId, signedAt])
}

// ── Phase 4: SaaS billing — architecture only, not connected to a payment
// provider. No Stripe (or other) keys are configured; nothing here can
// charge a card. Exists so feature-gating logic has something real to read
// from instead of being hardcoded, and so wiring up a real provider later is
// "add credentials + a webhook handler," not "design the data model."
model Plan {
  id              String   @id @default(cuid())
  key             String   @unique // matches the 3 tiers actually marketed on the landing page (src/components/landing/Packages.tsx): 'basic' | 'automation' | 'web'
  name            String
  // Nullable deliberately: the landing page markets these 3 tiers with NO
  // public price ("contact us") — a fixed JOD figure here would be an
  // invented number the marketing page itself doesn't claim.
  priceMonthlyJod Int?
  maxUsers        Int?
  maxCases        Int?
  aiCallsPerMonth Int?
  createdAt       DateTime @default(now())
  subscriptions   Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  officeId             String             @unique
  office               Office             @relation(fields: [officeId], references: [id])
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
}
